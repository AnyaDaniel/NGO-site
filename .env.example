# Public URL: set to your HTTPS domain before live payments.
PUBLIC_ORIGIN=http://127.0.0.1:5174
ALLOWED_ORIGINS=http://localhost:5174
PORT=3000
HOST=127.0.0.1
# Generate a long random administrator key; never commit or expose it in frontend code.
ADMIN_TOKEN=
# Keep this secret on the server. Begin with a Paystack sk_test_ key.
PAYSTACK_SECRET_KEY=
# PostgreSQL is recommended for deployment. Leave blank for local SQLite.
DATABASE_URL=
DATABASE_SSL=false
# SQLite needs a persistent disk. Never place this directory in public/ or dist/.
SQLITE_PATH=data/fodady.sqlite
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
